---
// Giscus comments — GitHub Discussions backed.
// Threads are mapped per page pathname into the "Announcements" category
// of mechaffin/mechaffin.github.io.
---

<section class="comments" aria-label="Comments">
	<script
		src="https://giscus.app/client.js"
		data-repo="mechaffin/mechaffin.github.io"
		data-repo-id="MDEwOlJlcG9zaXRvcnk1NTY0ODMxMw=="
		data-category="Announcements"
		data-category-id="DIC_kwDOA1EgOc4C8fmM"
		data-mapping="pathname"
		data-strict="0"
		data-reactions-enabled="1"
		data-emit-metadata="0"
		data-input-position="bottom"
		data-theme="light"
		data-lang="en"
		crossorigin="anonymous"
		async></script>
</section>

<style>
	.comments {
		width: 720px;
		max-width: calc(100% - 2em);
		margin: 3em auto 1em;
		padding: 0 1em;
	}
</style>
